# Sarvam speech, translation, and voice
SARVAM_API_KEY=replace-with-sarvam-api-key

# Required for history to survive restarts and work across bridge replicas.
# The bridge creates VaaniMessages alongside the existing user/call tables.
AZURE_STORAGE_CONNECTION_STRING=replace-with-azure-storage-connection-string

# Firebase Admin credential for the bridge backend
FIREBASE_SERVICE_ACCOUNT_BASE64=replace-with-base64-service-account-json

# LiveKit server credentials
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Bridge auth secret
BRIDGE_JWT_SECRET=replace-with-shared-secret

# Public HTTPS origin used to issue secure WebSocket connection URLs.
BRIDGE_PUBLIC_URL=https://your-bridge-host
